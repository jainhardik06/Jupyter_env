   "source": [
    "def fibo(n):\n",
    "    if n <= 0:\n",
    "        return 0\n",
    "    elif n==1:\n",
    "        return 1\n",
    "    else:\n",
    "        return fibo(n-1) + fibo(n-2)\n",
    "\n",
    "for i in range(11):\n",
    "    print(fibo(i), end=' ')"
   ]
